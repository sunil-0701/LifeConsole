# Reference only: Spring Boot does not automatically load .env files.
# Export these variables in your shell or set them in your IDE run configuration.
DB_URL=jdbc:postgresql://localhost:5432/lifeconsole
# Supply the PostgreSQL role and its password locally. Do not commit credentials.
DB_USERNAME=
DB_PASSWORD=
SERVER_PORT=8080
# Comma-separated exact origins; no wildcard origins or trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:5173
